generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  profile   PlayerProfile?
  sessions  Session[]
}

model PlayerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  money        Int      @default(1000)
  vaultLevel   Int      @default(1)
  ascension    Int      @default(0)
  
  pvpWins      Int      @default(0)
  pvpLosses    Int      @default(0)
  pvpKills     Int      @default(0)
  
  itemsCollected Int    @default(0)
  highestRarity    String @default("COMMON")
  marketVolume     Int   @default(0)
  playtimeMinutes  Int   @default(0)
  
  lastOnlineTime   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  vault            Vault?
  inventory        Inventory[]
  transactions     Transaction[]
  marketListings   MarketListing[]
  buyOrders        BuyOrder[]
  offlineCaches    OfflineCache[]
  notifications    Notification[]
  
  @@index([vaultLevel])
  @@index([ascension])
  @@index([money])
}

model Vault {
  id              String   @id @default(uuid())
  playerId        String   @unique
  player          PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  level           Int      @default(1)
  ascension       Int      @default(0)
  
  generatorLevel  Int      @default(1)
  storageLevel    Int      @default(1)
  securityLevel   Int      @default(1)
  
  storageCapacity Int      @default(20)
  currentStorage  Int      @default(0)
  
  value           Int      @default(0)
  
  lastBreachedAt  DateTime?
  breachCooldownUntil DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  upgrades        VaultUpgrade[]
  
  @@index([level])
  @@index([ascension])
}

model VaultUpgrade {
  id           String   @id @default(uuid())
  vaultId      String
  vault        Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  
  upgradeType  String
  level        Int      @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([vaultId, upgradeType])
}

model Inventory {
  id           String   @id @default(uuid())
  playerId     String
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  itemId       String
  itemType     String
  itemName     String
  rarity       String
  baseValue    Int
  description  String
  stackSize    Int
  tradable     Boolean @default(true)
  sellable     Boolean @default(true)
  
  quantity     Int      @default(1)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([playerId])
  @@index([itemId])
  @@index([rarity])
}

model ItemDefinition {
  id           String   @id @default(uuid())
  type         String
  name         String   @unique
  rarity       String
  baseValue    Int
  description  String
  stackSize    Int      @default(1)
  tradable     Boolean @default(true)
  sellable     Boolean @default(true)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([type])
  @@index([rarity])
}

model Transaction {
  id               String   @id @default(uuid())
  playerId         String
  player           PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  type             String
  amount           Int
  reason           String
  
  itemId           String?
  relatedPlayerId  String?
  relatedOrderId   String?
  
  createdAt        DateTime @default(now())
  
  @@index([playerId])
  @@index([type])
  @@index([createdAt])
}

model MarketListing {
  id           String   @id @default(uuid())
  playerId     String
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  itemId       String
  itemType     String
  itemName     String
  rarity       String
  quantity     Int
  pricePerUnit Int
  totalPrice   Int
  
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  
  @@index([expiresAt])
  @@index([itemType])
  @@index([rarity])
}

model BuyOrder {
  id           String   @id @default(uuid())
  playerId     String
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  itemType     String
  itemName     String
  quantity     Int
  remaining    Int
  pricePerUnit Int
  totalPrice   Int
  reservedFunds Int
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([itemType])
  @@index([itemName])
}

model CraftingRecipe {
  id           String   @id @default(uuid())
  name         String   @unique
  resultItem   String
  resultRarity String
  resultQuantity Int
  
  ingredients  String // JSON array of {itemType, quantity}
  currencyCost Int
  
  requiredVaultLevel  Int @default(1)
  requiredAscension   Int @default(0)
  
  isActive     Boolean @default(true)
  isEvent      Boolean @default(false)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([isActive])
  @@index([isEvent])
}

model CraftingTransaction {
  id           String   @id @default(uuid())
  playerId     String
  recipeId     String
  
  resultItem   String
  resultRarity String
  resultQuantity Int
  
  createdAt    DateTime @default(now())
  
  @@index([playerId])
}

model Event {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  
  startTime    DateTime
  endTime      DateTime
  
  isActive     Boolean @default(false)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([isActive])
}

model EventRecipe {
  id           String   @id @default(uuid())
  eventId      String
  recipeId     String
  
  createdAt    DateTime @default(now())
  
  @@unique([eventId, recipeId])
}

model PvPMatch {
  id           String   @id @default(uuid())
  player1Id    String
  player2Id    String
  
  winnerId     String?
  
  startTime    DateTime @default(now())
  endTime      DateTime?
  
  createdAt    DateTime @default(now())
  
  @@index([player1Id])
  @@index([player2Id])
}

model PvPCombatLog {
  id           String   @id @default(uuid())
  matchId      String
  playerId     String
  
  action       String
  targetId     String?
  damage       Int?
  
  timestamp    DateTime @default(now())
  
  @@index([matchId])
  @@index([playerId])
}

model Breach {
  id           String   @id @default(uuid())
  attackerId   String
  targetId     String
  
  success      Boolean
  moneyStolen  Int @default(0)
  itemsStolen  String // JSON array of item IDs
  
  createdAt    DateTime @default(now())
  
  @@index([attackerId])
  @@index([targetId])
  @@index([createdAt])
}

model OfflineCache {
  id           String   @id @default(uuid())
  playerId     String
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  offlineTime  Int // milliseconds
  itemsGenerated Int
  
  claimed      Boolean @default(false)
  
  createdAt    DateTime @default(now())
  claimedAt    DateTime?
  
  @@index([playerId])
  @@index([claimed])
}

model Leaderboard {
  id           String   @id @default(uuid())
  category     String
  
  playerId     String
  username     String
  value        Int
  
  updatedAt    DateTime @default(now())
  
  @@unique([category, playerId])
  @@index([category])
  @@index([value])
}

model Notification {
  id           String   @id @default(uuid())
  playerId     String
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  type         String
  title        String
  message      String
  data         String? // JSON
  
  read         Boolean @default(false)
  
  createdAt    DateTime @default(now())
  
  @@index([playerId])
  @@index([read])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token        String   @unique
  expiresAt    DateTime
  
  createdAt    DateTime @default(now())
  
  @@index([token])
  @@index([expiresAt])
}
