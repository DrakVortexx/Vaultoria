# Vaultoria environment configuration
# Copy this file to ".env" for local development.
#
# Neon connection string. In the Neon dashboard open your project,
# click "Connect" and copy the pooled connection string, e.g.:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: port (Render sets this automatically).
# PORT=3000
